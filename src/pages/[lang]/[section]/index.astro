---
// Section index pages: Reflect (signs), Live (morals), Ask (questions).
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import ItemList from '../../../components/ItemList.astro';
import { mdInline } from '../../../lib/md';
import { t, locales, otherLocale, type Locale, type UiKey } from '../../../i18n/ui';
import { itemUrl, sectionPath, sectionSegment, type Section } from '../../../lib/routes';
import { flowerOf } from '../../../lib/quests';

export function getStaticPaths() {
  return locales.flatMap((lang) =>
    (Object.keys(sectionSegment) as Section[]).map((section) => ({
      params: { lang, section: sectionSegment[section][lang] },
      props: { section },
    })),
  );
}
const lang = Astro.params.lang as Locale;
const { section } = Astro.props as { section: Section };
const meta: Record<Section, { title: UiKey; intro: UiKey }> = {
  signs: { title: 'sectionSigns', intro: 'signsIntro' },
  morals: { title: 'sectionMorals', intro: 'moralsIntro' },
  questions: { title: 'sectionQuestions', intro: 'questionsIntro' },
};
const entries = (await getCollection(section)).sort((a, b) => a.data.order - b.data.order);
const items = entries.map(({ data }) => ({
  id: data.id,
  href: itemUrl(section, data.slugs, lang),
  title: data.title[lang],
  summary: 'summary' in data && data.summary?.[lang] ? mdInline(data.summary[lang], lang) : undefined,
}));
---

<Base
  lang={lang}
  title={t(lang, meta[section].title)}
  description={t(lang, meta[section].intro)}
  altPath={sectionPath(section, otherLocale(lang))}
  section={section}
>
  <div class="wrap section">
    <h1>{t(lang, meta[section].title)}</h1>
    <p class="intro">{t(lang, meta[section].intro)}</p>
    <ItemList items={items} readLabel={t(lang, 'gardenRead')} flower={flowerOf[section]} />
  </div>
</Base>

<style>
  .section {
    padding-top: var(--space-6);
  }
  .intro {
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--ink-soft);
  }
</style>
