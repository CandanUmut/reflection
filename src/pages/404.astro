---
// Not found. GitHub Pages serves this for any missing path; it speaks both
// languages because we cannot know which one the visitor came from.
import Base from '../layouts/Base.astro';
import { localeUrl } from '../lib/paths';
---

<Base lang="tr" title="Sayfa bulunamadı · Page not found" standalone>
  <div class="wrap notfound">
    <h1>Bu sayfa burada değil.</h1>
    <p>Aradığınız sayfa taşınmış ya da hiç var olmamış olabilir.</p>
    <p>
      <a href={localeUrl('tr')}>Ana sayfaya dön</a>
    </p>
    <hr />
    <p lang="en">This page is not here. It may have moved, or never existed.</p>
    <p lang="en">
      <a href={localeUrl('en')}>Go to the home page</a>
    </p>
  </div>
</Base>

<style>
  .notfound {
    padding-top: var(--space-7);
    text-align: center;
  }
  hr {
    border: 0;
    border-top: var(--rule);
    width: 4rem;
    margin: var(--space-5) auto;
  }
</style>
