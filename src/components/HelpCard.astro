---
// The gentle help card (DESIGN.md §4.7) for pages on suffering, grief,
// disasters and vesvese. Quiet, never alarmist. Türkiye's resources are the
// ones named in the research (docs/research/02-batch-2.md, Task E): 112,
// community and university clinics, AFAD psychosocial support. For readers
// anywhere else: Find A Helpline (ThroughLine), a free directory of verified
// helplines in 175+ countries (checked 2026-10-31; see docs/CONTENT_GAPS.md).
// English pages lead with the world, Turkish pages with Türkiye.
import { t, type Locale } from '../i18n/ui';
interface Props {
  lang: Locale;
  /** general: high-sensitivity questions, resources only · vesvese: Q8 · suffering: grief, du'a, hopelessness · disaster: adds AFAD · urgent: emergency first (M13, Q6, Q25). */
  variant: 'general' | 'vesvese' | 'suffering' | 'disaster' | 'urgent';
}
const { lang, variant } = Astro.props;
---

<aside class="help" aria-labelledby="help-title">
  <h2 class="help__title" id="help-title">
    {t(lang, 'helpTitle')}
  </h2>
  {variant === 'general' && <p>{t(lang, 'helpGeneral')}</p>}
  {variant === 'vesvese' && <p>{t(lang, 'helpVesvese')}</p>}
  {(variant === 'suffering' || variant === 'disaster') && <p>{t(lang, 'helpSuffering')}</p>}
  <ul>
    {lang === 'en' && (
      <li>
        {t(lang, 'helpWorld')} <a href="https://findahelpline.com/">Find A Helpline</a> {t(lang, 'helpWorldText')}
      </li>
    )}
    {lang === 'en' && variant === 'urgent' && <li>{t(lang, 'helpLocalEmergency')}</li>}
    {variant === 'urgent' && (
      <li>
        {t(lang, 'helpEmergency')} <a href="tel:112">112</a>
      </li>
    )}
    <li>{t(lang, 'helpClinics')}</li>
    {variant === 'disaster' && <li>{t(lang, 'helpAfad')}</li>}
    {variant !== 'urgent' && (
      <li>
        {t(lang, 'helpEmergency')} <a href="tel:112">112</a>
      </li>
    )}
    {lang === 'tr' && (
      <li>
        {t(lang, 'helpWorld')} <a href="https://findahelpline.com/">Find A Helpline</a> {t(lang, 'helpWorldText')}
      </li>
    )}
    {(lang === 'tr' || variant !== 'urgent') && <li>{t(lang, 'helpLocalEmergency')}</li>}
  </ul>
</aside>

<style>
  .help {
    margin-block: var(--space-5);
    padding: var(--space-4);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--paper-deep);
  }
  .help__title {
    font-size: var(--step-1);
    margin-bottom: var(--space-2);
  }
  .help p {
    margin-bottom: var(--space-3);
  }
  ul {
    font-family: var(--font-ui);
    font-size: 0.9rem;
    margin: 0;
    padding-left: 1.1em;
  }
  li {
    margin-bottom: var(--space-1);
  }
</style>
