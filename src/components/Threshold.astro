---
// The Threshold (DESIGN.md §4.1): three arches drawn in thin line —
// Reflect · Live · Ask. Hovering, focusing or touching an arch fills it slowly
// with light from below, like dawn in a doorway. Above them, the invitation of
// the day: one short verse from the research index, changing daily.
import { parse } from 'yaml';
import dailyRaw from '../data/daily-verses.yaml?raw';
import { expandRef, joinTranslations, refLabel } from '../lib/quran';
import { t, type Locale } from '../i18n/ui';
import KundekariBand from './motifs/KundekariBand.astro';
import TileBorder from './motifs/TileBorder.astro';

interface Props {
  lang: Locale;
  links: { reflect: string; live: string; ask: string };
}
const { lang, links } = Astro.props;
const refs: string[] = parse(dailyRaw).refs;
const daily = refs.map((r) => ({
  ref: refLabel(r),
  text: joinTranslations(expandRef(r), lang),
}));
// Build-time choice, shown without JavaScript. With JavaScript the slot stays
// hidden until the script has put in the visitor's own day, so nothing swaps.
// Turkish local day (UTC+3), matching the daily rebuild in deploy.yml.
const dayIndex = Math.floor((Date.now() + 3 * 3600000) / 86400000) % daily.length;
const arches = [
  { key: 'reflect', href: links.reflect, label: t(lang, 'reflect'), hint: t(lang, 'reflectHint') },
  { key: 'live', href: links.live, label: t(lang, 'live'), hint: t(lang, 'liveHint') },
  { key: 'ask', href: links.ask, label: t(lang, 'ask'), hint: t(lang, 'askHint') },
] as const;
// Two-centred pointed arch (the Ottoman form), with a band of voussoirs that
// alternate İznik red and ivory stone, as in the arcades of Süleymaniye.
// Inner opening: span 24–116, springing at y = 100. Outer edge 14 units out.
const SPRING = 100,
  BASE = 228,
  XL = 24,
  XR = 116,
  R = 56,
  BAND = 14,
  PER_SIDE = 6;
const CL = XL + R,
  CR = XR - R; // the two centres
const apexAngle = (rad: number) => Math.acos((70 - CL) / rad); // where the left arc reaches x = 70
const ptL = (rad: number, a: number) => [CL + rad * Math.cos(a), SPRING - rad * Math.sin(a)];
const ptR = (rad: number, a: number) => [CR - rad * Math.cos(a), SPRING - rad * Math.sin(a)];
const f = (p: number[]) => `${p[0].toFixed(2)} ${p[1].toFixed(2)}`;
const side = (pt: typeof ptL) =>
  Array.from({ length: PER_SIDE }, (_, k) => {
    const ai = (rad: number, t: number) => Math.PI - (Math.PI - apexAngle(rad)) * t;
    const t0 = k / PER_SIDE,
      t1 = (k + 1) / PER_SIDE;
    return `M${f(pt(R, ai(R, t0)))} L${f(pt(R + BAND, ai(R + BAND, t0)))} L${f(pt(R + BAND, ai(R + BAND, t1)))} L${f(pt(R, ai(R, t1)))}Z`;
  });
// Stones in order from springing to keystone, left and right interleaved.
const left = side(ptL),
  right = side(ptR);
const voussoirs = left.flatMap((d, k) => [
  { d, k },
  { d: right[k], k },
]);
const innerArc = `M${XL} ${BASE} V${SPRING} A${R} ${R} 0 0 1 70 ${(SPRING - R * Math.sin(apexAngle(R))).toFixed(2)} A${R} ${R} 0 0 1 ${XR} ${SPRING} V${BASE}`;
const OPENING = innerArc + ' Z';
const KR = 20,
  kr = (KR * Math.cos(Math.PI / 4)) / Math.cos(Math.PI / 8);
const STAR =
  'M' +
  Array.from({ length: 16 }, (_, i) => {
    const a = (i * Math.PI) / 8,
      rr = i % 2 === 0 ? KR : kr;
    return `${(20 + rr * Math.cos(a)).toFixed(2)} ${(20 + rr * Math.sin(a)).toFixed(2)}`;
  }).join(' L') +
  'Z';
---

<section class="threshold">
  <figure class="invitation" data-invitation>
    <svg class="invitation__star" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
      <path d="M20 2 L25.3 14.7 L38 20 L25.3 25.3 L20 38 L14.7 25.3 L2 20 L14.7 14.7Z" />
      <path d="M7.3 7.3 L20 12.6 L32.7 7.3 L27.4 20 L32.7 32.7 L20 27.4 L7.3 32.7 L12.6 20Z" />
      <circle cx="20" cy="20" r="3" />
    </svg>
    <TileBorder height={28} class="invitation__band" />
    <figcaption class="label">{t(lang, 'invitation')}</figcaption>
    <blockquote>
      <p data-invitation-text>{daily[dayIndex].text}</p>
    </blockquote>
    <p class="invitation__ref ref" data-invitation-ref>
      {daily[dayIndex].ref}
    </p>
    <p class="invitation__credit">{t(lang, 'translationBy')}</p>
    <TileBorder height={28} class="invitation__band" />
    <script type="application/json" is:inline set:html={JSON.stringify(daily)} />
  </figure>
  <div class="arcade">
    <KundekariBand height={16} class="arcade__cornice" />
    <nav class="arches" aria-label={t(lang, 'siteName')}>
      {arches.map((a, i) => (
        <a class="arch" href={a.href}>
          <svg viewBox="10 0 120 232" aria-hidden="true" focusable="false" style={`--arch:${i}`}>
            <defs>
              <clipPath id={`arch-clip-${i}`}>
                <path d={OPENING} />
              </clipPath>
              <linearGradient id={`arch-light-${i}`} x1="0" y1="1" x2="0" y2="0">
                <stop offset="0" class="light-stop light-stop--low" />
                <stop offset="1" class="light-stop light-stop--high" />
              </linearGradient>
              <radialGradient id={`arch-glow-${i}`}>
                <stop offset="0" class="glow-stop glow-stop--core" />
                <stop offset="1" class="glow-stop glow-stop--edge" />
              </radialGradient>
              <pattern
                id={`arch-door-${i}`}
                width="40"
                height="40"
                patternUnits="userSpaceOnUse"
                patternTransform="scale(0.45)"
              >
                <path d={STAR} class="door-star" />
              </pattern>
            </defs>
            <g clip-path={`url(#arch-clip-${i})`}>
              <rect class="arch__door" x="0" y="0" width="140" height="232" fill={`url(#arch-door-${i})`} />
              <rect class="arch__light" x="0" y="0" width="140" height="232" fill={`url(#arch-light-${i})`} />
            </g>
            {/* A mosque lamp (kandil) hanging from the crown of the arch on its chain. */}
            <g class="lamp">
              <circle class="lamp__glow" cx="70" cy="134" r="30" fill={`url(#arch-glow-${i})`} />
              <path class="lamp__chain" d="M70 45 V112 M70 112 L59.5 125 M70 112 L80.5 125" />
              <circle class="lamp__link" cx="70" cy="68" r="1.3" />
              <circle class="lamp__link" cx="70" cy="90" r="1.3" />
              <path class="lamp__glass" d="M59 125.5 C58.6 137.5 62.6 145.6 70 148 C77.4 145.6 81.4 137.5 81 125.5 Z" />
              <path class="lamp__band" d="M60 132 C66 134.4 74 134.4 80 132" />
              <path class="lamp__flame" d="M70 126.5 C67.4 131 67.7 134.6 70 136.4 C72.3 134.6 72.6 131 70 126.5Z" />
              <path class="lamp__rim" d="M57.5 125 H82.5" />
              <path class="lamp__chain" d="M70 148 V153" />
              <circle class="lamp__link lamp__finial" cx="70" cy="154.6" r="1.8" />
            </g>
            <rect class="jamb" x={XL - BAND} y={SPRING} width={BAND} height={BASE - SPRING} />
            <rect class="jamb" x={XR} y={SPRING} width={BAND} height={BASE - SPRING} />
            {voussoirs.map((v, n) => (
              <path
                d={v.d}
                class:list={['stone', v.k % 2 === 0 ? 'stone--red' : 'stone--ivory']}
                style={`--k:${v.k};--n:${n}`}
              />
            ))}
            <path class="arch__line" d={innerArc} />
            <line class="arch__sill" x1="0" y1={BASE} x2="140" y2={BASE} />
          </svg>
          <span class="arch__label">{a.label}</span>
          <span class="arch__hint">{a.hint}</span>
        </a>
      ))}
    </nav>
  </div>
</section>

<style>
  .threshold {
    padding-block: var(--space-6) var(--space-5);
    padding-inline: var(--space-3);
    text-align: center;
  }
  .invitation {
    margin: 0 auto var(--space-6);
    max-width: 34rem;
  }
  .invitation blockquote {
    margin: var(--space-2) 0;
  }
  .invitation blockquote p {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-1);
    line-height: 1.45;
    margin: 0;
  }
  .invitation__ref {
    margin: var(--space-2) 0 0;
  }
  .invitation__credit {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: var(--ink-soft);
    margin: var(--space-1) 0 0;
  }
  :global(.js) .invitation:not([data-ready]) blockquote,
  :global(.js) .invitation:not([data-ready]) .invitation__ref {
    visibility: hidden;
  }
  /* One arcade (revak), as in Süleymaniye's courtyard: arches side by side on
     shared piers under a carved cornice. */
  .arcade {
    max-width: 50rem;
    margin-inline: auto;
  }
  .arcade :global(.arcade__cornice) {
    margin-bottom: var(--space-2);
  }
  .arches {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
  }
  .invitation__star {
    width: 2rem;
    height: 2rem;
    margin: 0 auto var(--space-3);
    display: block;
    fill: none;
    stroke: var(--cobalt);
    stroke-width: 1.3;
  }
  .invitation__star circle {
    fill: var(--clay);
    stroke: none;
  }
  .invitation :global(.invitation__band) {
    max-width: 22rem;
    margin: var(--space-4) auto;
  }
  .arch {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: var(--space-2);
    text-decoration: none;
    border-radius: var(--radius);
    padding-block: 0 var(--space-2);
  }
  .arch svg {
    width: 100%;
    max-width: none;
    height: auto;
    overflow: visible;
  }
  .stone {
    stroke: var(--ink-soft);
    stroke-width: 0.6;
    transition: fill 1.2s var(--ease-breath) calc(var(--k) * 0.12s);
  }
  /* Ablaq: İznik red and ivory stone, alternating. */
  .stone--red {
    fill: var(--clay);
  }
  .stone--ivory {
    fill: var(--paper);
  }
  .jamb {
    fill: var(--paper);
    stroke: var(--ink-soft);
    stroke-width: 0.6;
  }
  .arch__line {
    fill: none;
    stroke: var(--lamp-line);
    stroke-width: 1;
  }
  .arch__sill {
    stroke: var(--hairline-strong);
    stroke-width: 1;
  }
  .door-star {
    fill: none;
    stroke: var(--cobalt);
    stroke-width: 1.6;
  }
  .arch__door {
    opacity: 0.16;
    transition: opacity 2s var(--ease-breath);
  }
  .light-stop--low {
    stop-color: var(--lamp-line);
    stop-opacity: 0.3;
  }
  .light-stop--high {
    stop-color: var(--lamp-line);
    stop-opacity: 0;
  }
  .arch__light {
    transform-box: view-box;
    transform-origin: 50% 100%;
    transform: scaleY(0);
    transition: transform 2.6s var(--ease-breath);
  }
  /* Dawn in a doorway: light rises from below, the carved door shows, and the
     ivory stones warm one by one from the springing to the keystone. */
  .arch:hover .arch__light,
  .arch:focus-visible .arch__light,
  .arch:active .arch__light {
    transform: scaleY(1);
  }
  .arch:hover .arch__door,
  .arch:focus-visible .arch__door {
    opacity: 0.32;
  }
  .arch:hover .stone--ivory,
  .arch:focus-visible .stone--ivory {
    fill: color-mix(in srgb, var(--lamp-line) 38%, var(--paper));
  }
  /* On arrival the arches are built stone by stone, one arch after another. */
  :global(.js) .arches:not(.is-built) .stone {
    opacity: 0;
  }
  .arches.is-built .stone {
    transition:
      opacity 0.7s var(--ease-breath) calc(var(--arch) * 0.9s + var(--n) * 0.06s),
      fill 1.2s var(--ease-breath) calc(var(--k) * 0.12s);
  }
  /* The lamps: a glass bowl, a small flame, and a glow that breathes unevenly,
     each lamp in its own time. They brighten when an arch is chosen. */
  .glow-stop--core {
    stop-color: var(--lamp-line);
    stop-opacity: 0.5;
  }
  .glow-stop--edge {
    stop-color: var(--lamp-line);
    stop-opacity: 0;
  }
  .lamp__chain {
    fill: none;
    stroke: var(--lamp-line);
    stroke-width: 0.8;
  }
  .lamp__link {
    fill: none;
    stroke: var(--lamp-line);
    stroke-width: 0.8;
  }
  .lamp__finial {
    fill: var(--lamp-line);
  }
  .lamp__glass {
    fill: color-mix(in srgb, var(--turquoise) 30%, var(--paper));
    stroke: var(--cobalt);
    stroke-width: 0.7;
  }
  .lamp__band {
    fill: none;
    stroke: var(--cobalt);
    stroke-width: 0.6;
  }
  .lamp__rim {
    stroke: var(--lamp-line);
    stroke-width: 1.8;
    stroke-linecap: round;
  }
  .lamp__flame {
    fill: var(--clay);
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }
  .lamp__glow {
    transform-box: fill-box;
    transform-origin: center;
    transition:
      transform 1.6s var(--ease-breath),
      opacity 1.6s var(--ease-breath);
  }
  .arch:hover .lamp__glow,
  .arch:focus-visible .lamp__glow {
    transform: scale(1.25);
  }
  /* On arrival each lamp breathes twice (under five seconds) and then rests;
     the flame stirs only while its arch is hovered or focused. Nothing moves
     on its own for longer than five seconds (WCAG 2.2.2). */
  @media (prefers-reduced-motion: no-preference) {
    .lamp__glow {
      animation: lamp-breathe 2.3s ease-in-out 2;
      animation-delay: calc(var(--arch) * 0.15s);
    }
    .arch:hover .lamp__flame,
    .arch:focus-visible .lamp__flame {
      animation: lamp-flicker 4.6s ease-in-out infinite;
    }
  }
  @keyframes lamp-breathe {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.72;
    }
  }
  @keyframes lamp-flicker {
    0%,
    100% {
      transform: scale(1, 1);
    }
    35% {
      transform: scale(0.96, 1.05);
    }
    70% {
      transform: scale(1.02, 0.97);
    }
  }
  .arch__label {
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.2;
  }
  .arch__hint {
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--ink-soft);
    max-width: 13rem;
  }
  @media (max-width: 30rem) {
    .arch__hint {
      font-size: 0.78rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .arch__light {
      transition: none;
    }
    :global(.js) .arches:not(.is-built) .stone {
      opacity: 1;
    }
  }
</style>

<script>
  // Build the arches once, when they first come into view.
  const arches = document.querySelector('.arches');
  if (arches && !('IntersectionObserver' in window)) arches.classList.add('is-built');
  else if (arches) {
    const io = new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting) {
          arches.classList.add('is-built');
          io.disconnect();
        }
      },
      { threshold: 0.3 },
    );
    io.observe(arches);
  }
  for (const fig of document.querySelectorAll<HTMLElement>('[data-invitation]')) {
    const list: { ref: string; text: string }[] = JSON.parse(fig.querySelector('script')!.textContent!);
    const now = new Date();
    const localDay = Math.floor((now.getTime() - now.getTimezoneOffset() * 60000) / 86400000);
    const today = list[localDay % list.length];
    fig.querySelector('[data-invitation-text]')!.textContent = today.text;
    fig.querySelector('[data-invitation-ref]')!.textContent = today.ref;
    fig.dataset.ready = '';
  }
</script>
