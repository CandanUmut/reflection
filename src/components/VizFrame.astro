---
// Shared frame for every visualization (DESIGN.md §4.8): a title, the drawing,
// a live caption, controls, and a full text equivalent that is always there.
// Each visualization explains one thing; nothing depends on motion.
import { md } from '../lib/md';
import { t, type Locale } from '../i18n/ui';
interface Props {
  lang: Locale;
  title: string;
  textVersion?: string | undefined;
  /** data-* hook the visualization's own script looks for. */
  kind: string;
}
const { lang, title, textVersion, kind } = Astro.props;
---

<figure class="viz" data-viz={kind}>
  <figcaption class="viz__title label">{title}</figcaption>
  <div class="viz__stage">
    <slot />
  </div>
  <div class="viz__controls">
    <slot name="controls" />
  </div>
  {textVersion && (
    <details class="viz__text">
      <summary>{t(lang, 'textVersion')}</summary>
      <div set:html={md(textVersion, lang)} />
    </details>
  )}
</figure>

<style>
  .viz {
    margin: var(--space-5) 0;
    padding: var(--space-4) 0;
    border-block: 1px solid var(--hairline);
  }
  .viz__title {
    margin-bottom: var(--space-3);
  }
  .viz__stage :global(svg) {
    display: block;
    width: 100%;
    max-width: 28rem;
    height: auto;
    margin-inline: auto;
    overflow: visible;
  }
  .viz__controls {
    display: grid;
    gap: var(--space-2);
    max-width: 28rem;
    margin: var(--space-3) auto 0;
    font-family: var(--font-ui);
    font-size: var(--step--1);
  }
  .viz__controls :global(label) {
    display: grid;
    gap: var(--space-1);
  }
  .viz__controls :global(input[type='range']) {
    width: 100%;
    accent-color: var(--water);
    min-height: 2.75rem;
  }
  .viz__controls :global(.viz__readout) {
    font-family: var(--font-text);
    font-size: var(--step-0);
    color: var(--ink);
    min-height: 3.3em;
  }
  .viz__controls :global(.viz__row) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
  }
  .viz__text {
    margin: var(--space-3) auto 0;
    max-width: 30rem;
    font-size: 0.95em;
  }
  .viz__text summary {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--ink-soft);
    cursor: pointer;
    min-height: 2.75rem;
    display: flex;
    align-items: center;
  }
  /* Shared drawing styles */
  .viz :global(.v-ground) {
    stroke: var(--hairline-strong);
    stroke-width: 1;
  }
  .viz :global(.v-ink) {
    fill: none;
    stroke: var(--ink-soft);
    stroke-width: 1.5;
  }
  .viz :global(.v-lamp) {
    fill: var(--lamp-line);
  }
  .viz :global(.v-line-lamp) {
    fill: none;
    stroke: var(--lamp-line);
    stroke-width: 1.2;
  }
  .viz :global(.v-text) {
    font: 500 12px var(--font-ui);
    fill: var(--ink-soft);
  }
  .viz :global(.v-fill-soft) {
    fill: var(--paper-deep);
  }
</style>
