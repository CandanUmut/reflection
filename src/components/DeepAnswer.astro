---
// The deep answer, shared by Ask, Live and Reflect pages: parts with their
// headings, shown in full (Umut's decision: the page's "On this page" bar lets
// readers move around, so nothing is folded), then the questions readers ask next. A language shows it only when every part exists
// in that language; pages pass `show` accordingly.
import { md, mdPlainInline } from '../lib/md';
import { t, type Locale, type UiKey } from '../i18n/ui';
import { partHeading } from '../lib/parts';

type Text = { tr?: string; en: string };
interface Props {
  lang: Locale;
  parts: (Text & { kind: string; title?: { tr?: string; en: string } })[];
  followUps?: { q: Text; a: Text }[];
  /** Heading of the whole block: "The full answer" (Ask) or "Go deeper" (Live, Reflect). */
  heading?: UiKey;
}
const { lang, parts, followUps = [], heading = 'fullAnswer' } = Astro.props;

// About 200 words a minute; the fold is decided on the English count, so both languages fold alike.
const words = (l: Locale) => parts.reduce((n, s) => n + (s[l] ?? '').split(/\s+/).length, 0);
const minutes = Math.max(1, Math.round(words(lang) / 200));
const asked = followUps.filter((f) => f.q[lang] && f.a[lang]);
const id = `deep-${heading}`;
---

{parts.length > 0 && (
  <section class="full" aria-labelledby={id}>
    <h2 id={id}>{t(lang, heading)}</h2>
    <p class="full__time">
      {minutes} {t(lang, 'minRead')}
    </p>
    {parts.map((part, i) => (
      <section class:list={['full__part', `full__part--${part.kind}`]} data-part={i} id={`part-${i}`}>
        <h3>{partHeading(part, lang, t)}</h3>
        <Fragment set:html={md(part[lang] ?? '', lang)} />
      </section>
    ))}
  </section>
)}

{asked.length > 0 && (
  <section class="followups" aria-labelledby={`${id}-asked`}>
    <h2 id={`${id}-asked`}>{t(lang, 'followUps')}</h2>
    {asked.map((f) => (
      <details class="followups__item">
        <summary>
          <span set:html={mdPlainInline(f.q[lang] ?? '', lang)} />
        </summary>
        <div class="followups__body">
          <Fragment set:html={md(f.a[lang] ?? '', lang)} />
        </div>
      </details>
    ))}
  </section>
)}

<style>
  .full {
    margin-block: var(--space-6) var(--space-5);
  }
  .full > h2 {
    font-size: var(--step-1);
  }
  .full__time {
    font-family: var(--font-ui);
    font-size: 0.8rem;
    color: var(--ink-soft);
    margin: calc(-1 * var(--space-2)) 0 0;
  }
  .full__part {
    margin-top: var(--space-5);
  }
  .full__part h3 {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--step-1);
    font-family: var(--font-display);
    font-weight: 600;
    margin-bottom: var(--space-3);
    padding-top: var(--space-4);
    border-top: var(--rule);
  }
  /* A small tile rosette dot before each heading, in the section's own colour. */
  .full__part h3::before {
    content: '';
    flex: none;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--turquoise);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--turquoise) 25%, transparent);
  }
  .full__part--quran h3::before,
  .full__part--tafsir h3::before {
    background: var(--cobalt);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--cobalt) 25%, transparent);
  }
  .full__part--objection h3::before,
  .full__part--views h3::before {
    background: var(--clay);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--clay) 25%, transparent);
  }
  /* The heart and daily-practice parts are set apart as warm cards. */
  .full__part--heart,
  .full__part--practice {
    padding: var(--space-2) var(--space-4) var(--space-3);
    background: var(--paper-deep);
    border-radius: var(--radius);
  }
  .full__part--heart h3,
  .full__part--practice h3 {
    border-top: 0;
  }
  .full__part--heart h3::before {
    background: var(--clay);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--clay) 25%, transparent);
  }
  .full__part--practice h3::before {
    background: var(--life);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--life) 25%, transparent);
  }
  .followups {
    margin-block: var(--space-6) var(--space-5);
  }
  .followups > h2 {
    font-size: var(--step-1);
  }
  .followups__item {
    border-top: var(--rule);
  }
  .followups__item:last-child {
    border-bottom: var(--rule);
  }
  .followups__item summary {
    font-family: var(--font-text);
    font-size: var(--step-0);
    font-style: italic;
  }
  .followups__body {
    padding-bottom: var(--space-3);
  }
  .followups summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 3.25rem;
    cursor: pointer;
    list-style: none;
  }
  .followups summary::-webkit-details-marker {
    display: none;
  }
  .followups summary::after {
    content: '+' / '';
    font-family: var(--font-ui);
    color: var(--ink-soft);
    transition: transform var(--dur-ui) var(--ease-breath);
  }
  .followups details[open] summary::after {
    transform: rotate(45deg);
  }
</style>
