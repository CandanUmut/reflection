---
import { t, type Locale } from '../i18n/ui';
interface Props {
  sources: { label: string | { tr: string; en: string }; url?: string | undefined }[];
  lang: Locale;
}
const { sources, lang } = Astro.props;
const label = (l: string | { tr: string; en: string }) => (typeof l === 'string' ? l : l[lang]);
---

<section class="sources" aria-labelledby="sources-title">
  <h2 class="label" id="sources-title">
    {t(lang, 'sources')}
  </h2>
  <ol>
    {sources.map((s) => (
      <li>
        {s.url ? (
          <a href={s.url} rel="noopener">
            {label(s.label)}
          </a>
        ) : (
          label(s.label)
        )}
      </li>
    ))}
  </ol>
</section>

<style>
  .sources {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: var(--rule);
  }
  .sources h2 {
    margin-bottom: var(--space-3);
    font-size: 0.95rem;
  }
  ol {
    font-family: var(--font-ui);
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--ink-soft);
    padding-left: 1.4em;
  }
  li {
    margin-bottom: var(--space-2);
    overflow-wrap: anywhere;
  }
</style>
