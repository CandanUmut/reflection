---
import { t, type Locale } from '../i18n/ui';
import { mdInline } from '../lib/md';
interface Props {
  sources: { label: string | { tr: string; en: string }; url?: string | undefined }[];
  lang: Locale;
}
const { sources, lang } = Astro.props;
// Labels may carry inline Markdown (*book titles*); rendered at build time.
const label = (l: string | { tr: string; en: string }) => mdInline(typeof l === 'string' ? l : l[lang], lang);
---

<section class="sources" aria-labelledby="sources-title">
  <h2 class="label" id="sources-title">
    {t(lang, 'sources')}
  </h2>
  <ol>
    {sources.map((s) => (
      <li>
        {s.url ? <a href={s.url} rel="noopener" set:html={label(s.label)} /> : <Fragment set:html={label(s.label)} />}
      </li>
    ))}
  </ol>
</section>

<style>
  .sources {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: var(--rule);
  }
  .sources h2 {
    margin-bottom: var(--space-3);
    font-size: 0.95rem;
  }
  ol {
    font-family: var(--font-ui);
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--ink-soft);
    padding-left: 1.4em;
  }
  li {
    margin-bottom: var(--space-2);
    overflow-wrap: anywhere;
  }
</style>
