---
// The Honest Note (DESIGN.md §4.3): a scholar's margin note in clay.
// Always visible, never behind a click.
import { t, type Locale } from '../i18n/ui';
interface Props {
  lang: Locale;
  /** Defaults to "Honest note"; questions use "Honest limits", morals "the gap between ideal and practice". */
  label?: string;
  /** The research marks this note as important; it is set apart a little more. */
  important?: boolean;
}
const { lang, label, important = false } = Astro.props;
---

<aside class:list={['honest-note', { 'honest-note--important': important }]}>
  <p class="honest-note__label">
    {label ?? t(lang, 'honestNote')}
    {important && <> · {t(lang, 'important')}</>}
  </p>
  <div class="honest-note__body">
    <slot />
  </div>
</aside>

<style>
  /* The Honest Note has a colour of its own, used nowhere else on the site,
     and a faint wash of it, so it stands apart from every ornament. */
  .honest-note {
    border-left: 2px solid var(--honest);
    background: color-mix(in srgb, var(--honest) 5%, var(--paper));
    padding: var(--space-2) var(--space-3);
    margin: var(--space-4) 0;
    color: var(--ink);
  }
  .honest-note__label {
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--honest);
    margin: 0 0 var(--space-1);
  }
  .honest-note__body {
    font-family: var(--font-text);
    font-style: italic;
    font-size: 0.95em;
    line-height: 1.6;
  }
  .honest-note__body :global(p:last-child) {
    margin-bottom: 0;
  }
  .honest-note--important {
    border-left-width: 4px;
  }
</style>
