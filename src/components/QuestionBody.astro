---
// A question page as a layered answer (DESIGN.md §4.5): the steelmanned
// question first, in full and with respect → why it is asked → short answer
// → the full answer (Quran, Sunnah, scholars, fiqh, history or science, the
// strongest objection), folded behind "Read the full answer" when long →
// depth layers the reader opens by choice → range of views → questions readers
// ask next → honest limits (always visible) → help card where needed → sources.
import type { CollectionEntry } from 'astro:content';
import VerseBlock from './VerseBlock.astro';
import VerseList from './VerseList.astro';
import HonestNote from './HonestNote.astro';
import HelpCard from './HelpCard.astro';
import RangeOfViews from './RangeOfViews.astro';
import Sources from './Sources.astro';
import { md, mdInline } from '../lib/md';
import { t, type Locale, type UiKey } from '../i18n/ui';

interface Props {
  q: CollectionEntry<'questions'>['data'];
  lang: Locale;
}
const { q, lang } = Astro.props;
const sectionLabel: Record<string, UiKey> = {
  quran: 'secQuran',
  sunnah: 'secSunnah',
  scholars: 'secScholars',
  fiqh: 'secFiqh',
  history: 'secHistory',
  science: 'secScience',
  reasoning: 'secReasoning',
  objection: 'secObjection',
  heart: 'secHeart',
};
// Reading time of the full answer, at about 200 words a minute. Above ~700
// words, everything after the first part waits behind "Read the full answer".
const fullWords = (q.fullAnswer ?? []).reduce((n, s) => n + s[lang].split(/\s+/).length, 0);
const minutes = Math.max(1, Math.round(fullWords / 200));
const folded = fullWords > 700 && (q.fullAnswer?.length ?? 0) > 1;
const layerLabel: Record<string, UiKey> = {
  religious: 'layerReligious',
  philosophical: 'layerPhilosophical',
  scientific: 'layerScientific',
  clinical: 'layerClinical',
  psychological: 'layerPsychological',
  history: 'layerHistory',
};
---

<article class="question wrap">
  <header class="question__head">
    <p class="label">{q.id}</p>
    <h1>{q.title[lang]}</h1>
  </header>

  <section class="steelman" aria-labelledby="steelman-title">
    <h2 class="label" id="steelman-title">
      {t(lang, 'steelman')}
    </h2>
    <Fragment set:html={md(q.steelman[lang], lang)} />
  </section>

  <section class="block" aria-labelledby="why-title">
    <h2 class="label" id="why-title">
      {t(lang, 'whyAsked')}
    </h2>
    <Fragment set:html={md(q.whyAsked[lang], lang)} />
  </section>

  <section class="short" aria-labelledby="short-title">
    <h2 id="short-title">{t(lang, 'shortAnswer')}</h2>
    <Fragment set:html={md(q.shortAnswer[lang], lang)} />
  </section>

  {q.helpCard && q.helpCard !== 'general' && <HelpCard lang={lang} variant={q.helpCard} />}

  {q.fullAnswer && (
    <section class="full" aria-labelledby="full-title" data-full={folded ? '' : undefined}>
      <h2 id="full-title">
        {t(lang, 'fullAnswer')}
        <span class="full__time">
          · {minutes} {t(lang, 'minRead')}
        </span>
      </h2>
      {q.fullAnswer.map((part, i) => (
        <section class="full__part" data-part={i}>
          <h3>{part.title?.[lang] ?? t(lang, sectionLabel[part.kind])}</h3>
          <Fragment set:html={md(part[lang], lang)} />
        </section>
      ))}
      {folded && (
        <button class="full__more btn" type="button" hidden>
          {t(lang, 'readMore')}
        </button>
      )}
    </section>
  )}

  {q.layers.length > 0 && (
    <section class="depth" aria-labelledby="depth-title">
      <h2 class="label" id="depth-title">
        {t(lang, 'goDeeper')}
      </h2>
      {q.layers.map((layer) => (
        <details class="depth__layer">
          <summary>{t(lang, layerLabel[layer.kind])}</summary>
          <div class="depth__body">
            <Fragment set:html={md(layer[lang], lang)} />
          </div>
        </details>
      ))}
    </section>
  )}

  {q.rangeOfViews && <RangeOfViews lang={lang} range={q.rangeOfViews} />}

  {q.followUps && q.followUps.length > 0 && (
    <section class="followups" aria-labelledby="followups-title">
      <h2 id="followups-title">{t(lang, 'followUps')}</h2>
      {q.followUps.map((f) => (
        <details class="followups__item">
          <summary set:html={mdInline(f.q[lang], lang)} />
          <div class="followups__body">
            <Fragment set:html={md(f.a[lang], lang)} />
          </div>
        </details>
      ))}
    </section>
  )}

  <HonestNote lang={lang} label={t(lang, 'honestLimits')}>
    <Fragment set:html={md(q.honestLimits[lang], lang)} />
  </HonestNote>

  {q.helpCard === 'general' && <HelpCard lang={lang} variant="general" />}

  {q.verses.length > 0 && (
    <section class="verses-ref" aria-labelledby="verses-title">
      <h2 class="label" id="verses-title">
        {t(lang, 'keyVerses')}
      </h2>
      <VerseBlock refs={q.verses.slice(0, 1)} lang={lang} size="small" />
      {q.verses.length > 1 && <VerseList refs={q.verses.slice(1)} lang={lang} />}
    </section>
  )}

  <Sources sources={q.sources} lang={lang} />
</article>

<style>
  .full {
    margin-block: var(--space-6) var(--space-5);
  }
  .full > h2 {
    font-size: var(--step-1);
  }
  .full__time {
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--ink-soft);
  }
  .full__part {
    margin-top: var(--space-5);
  }
  .full__part h3 {
    font-size: var(--step-0);
    font-family: var(--font-display);
    font-weight: 600;
    margin-bottom: var(--space-2);
  }
  .full__more {
    margin-top: var(--space-4);
  }
  .followups {
    margin-block: var(--space-6) var(--space-5);
  }
  .followups > h2 {
    font-size: var(--step-1);
  }
  .followups__item {
    border-top: var(--rule);
  }
  .followups__item:last-child {
    border-bottom: var(--rule);
  }
  .followups__item summary {
    font-family: var(--font-text);
    font-size: var(--step-0);
    font-style: italic;
  }
  .followups__body {
    padding-bottom: var(--space-3);
  }
  .question__head {
    padding-top: var(--space-6);
    margin-bottom: var(--space-5);
  }
  .question__head h1 {
    font-size: var(--step-2);
    line-height: 1.3;
  }
  .steelman {
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.5;
    padding-left: var(--space-4);
    border-left: 1px solid var(--lamp-line);
    margin-bottom: var(--space-5);
  }
  .steelman h2 {
    font-size: 0.95rem;
  }
  .block {
    margin-bottom: var(--space-5);
    color: var(--ink-soft);
  }
  .short {
    margin-bottom: var(--space-5);
  }
  .short h2 {
    font-size: var(--step-1);
  }
  .depth {
    margin-block: var(--space-6) var(--space-5);
  }
  .depth__layer {
    border-top: var(--rule);
  }
  .depth__layer:last-child {
    border-bottom: var(--rule);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 3.25rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-size: var(--step-0);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+' / '';
    font-family: var(--font-ui);
    color: var(--ink-soft);
    transition: transform var(--dur-ui) var(--ease-breath);
  }
  details[open] summary::after {
    transform: rotate(45deg);
  }
  .depth__body {
    padding-bottom: var(--space-4);
  }
  .depth__body :global(ul) {
    padding-left: 1.1em;
  }
  .depth__body :global(li) {
    margin-bottom: var(--space-2);
  }
  .verses-ref {
    margin-top: var(--space-6);
  }
</style>

<script>
  // "Read the full answer": a long answer shows its first part, and the rest
  // waits behind one button. The hidden parts stay findable with the browser's
  // find-in-page (hidden="until-found"), which opens them. Without JavaScript
  // the whole answer is simply shown.
  for (const full of document.querySelectorAll<HTMLElement>('[data-full]')) {
    const parts = [...full.querySelectorAll<HTMLElement>('.full__part')].slice(1);
    const button = full.querySelector<HTMLButtonElement>('.full__more');
    if (!button || !parts.length) continue;
    const open = () => {
      for (const p of parts) p.removeAttribute('hidden');
      button.remove();
    };
    for (const p of parts) {
      p.setAttribute('hidden', 'until-found');
      p.addEventListener('beforematch', open);
    }
    button.hidden = false;
    button.addEventListener('click', () => {
      open();
      const h = parts[0].querySelector<HTMLElement>('h3');
      if (h) {
        h.tabIndex = -1;
        h.focus();
      }
    });
  }
</script>
