---
// A calm list of items in a section: id, title, one line of summary.
interface Props {
  items: { id: string; href: string; title: string; summary?: string | undefined }[];
  /** Screen-reader word for a page the reader has finished ("read"). */
  readLabel: string;
  /** This section's flower in the reader's garden. */
  flower: 'tulip' | 'carnation' | 'rosette';
}
const { items, readLabel, flower } = Astro.props;
const flowerT = flower === 'rosette' ? 'translate(0 -20) scale(1.2)' : 'translate(0 -4) scale(0.8)';
---

<ol class="items">
  {items.map((i) => (
    <li data-item-id={i.id}>
      <a href={i.href}>
        <span class="ref">{i.id}</span>
        <span class="items__title">
          {i.title}
          <span class="items__done" hidden>
            <svg class="items__flower" viewBox="-12 -40 24 42" aria-hidden="true" focusable="false">
              <use href={`#fl-${flower}`} transform={flowerT} />
            </svg>
            <span class="visually-hidden">{readLabel}</span>
          </span>
        </span>
        {i.summary && <span class="items__summary" set:html={i.summary} />}
      </a>
    </li>
  ))}
</ol>

<script>
  // Pages the reader has finished get a small flower beside their title.
  import { load } from '../lib/progress';
  const done = load();
  for (const li of document.querySelectorAll<HTMLElement>('[data-item-id]')) {
    li.querySelector<HTMLElement>('.items__done')!.hidden = !done[li.dataset.itemId!];
  }
</script>

<style>
  .items__flower {
    width: 0.8em;
    height: auto;
    margin-left: 0.3em;
    vertical-align: -0.05em;
    overflow: visible;
  }
  .items {
    list-style: none;
    padding: 0;
    margin: var(--space-5) 0;
  }
  li {
    border-top: var(--rule);
  }
  li:last-child {
    border-bottom: var(--rule);
  }
  a {
    display: grid;
    grid-template-columns: 3rem 1fr;
    column-gap: var(--space-3);
    padding-block: var(--space-4);
    text-decoration: none;
  }
  .ref {
    padding-top: 0.35em;
  }
  .items__title {
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.3;
  }
  .items__summary {
    grid-column: 2;
    color: var(--ink-soft);
    font-size: 0.95rem;
    margin-top: var(--space-1);
  }
  a:hover .items__title {
    text-decoration: underline;
    text-decoration-color: var(--lamp);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
</style>
