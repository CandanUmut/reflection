---
// S10 · Birds held in the sky. The 2022 juvenile godwit's nonstop flight,
// Alaska to Tasmania: about 13,560 km in 11 days and 1 hour. A day counter and
// a fat ("fuel") gauge that runs down. The route and the gauge are drawn
// schematically — no map data, no fat-burning curve — and say so.
// Plays only when asked; can be paused and scrubbed.
import VizFrame from '../VizFrame.astro';
import { t, type Locale } from '../../i18n/ui';
interface Props {
  lang: Locale;
  title: string;
  textVersion?: string | undefined;
  labels: Record<string, string>;
}
const { lang, title, textVersion, labels: L } = Astro.props;
const ROUTE = 'M40 30 C 120 70, 170 120, 210 160 S 270 205, 290 215';
---

<VizFrame lang={lang} title={title} textVersion={textVersion} kind="godwit">
  <svg viewBox="0 0 320 240" role="img" aria-label={title} focusable="false">
    <rect class="v-fill-soft" x="0" y="0" width="320" height="240" rx="3" />
    <path class="route" d={ROUTE} />
    <path class="route-done" d={ROUTE} pathLength="1" />
    <circle class="end" cx="40" cy="30" r="3" />
    <circle class="end" cx="290" cy="215" r="3" />
    <text class="v-text" x="48" y="26">
      {L.alaska}
    </text>
    <text class="v-text" x="282" y="234" text-anchor="end">
      {L.tasmania}
    </text>
    <circle class="bird v-lamp" r="5" cx="40" cy="30" />
    <g transform="translate(20 190)">
      <text class="v-text" x="0" y="-6">
        {L.fuel}
      </text>
      <rect class="gauge" x="0" y="0" width="110" height="10" rx="2" />
      <rect class="gauge-fill" x="0" y="0" width="110" height="10" rx="2" />
    </g>
  </svg>
  <Fragment slot="controls">
    <p class="viz__readout" aria-live="polite" data-readout></p>
    <label>
      {L.progress}
      <input type="range" min="0" max="1" step="0.005" value="0" data-progress />
    </label>
    <div class="viz__row">
      <button class="btn" type="button" data-play aria-pressed="false">
        {t(lang, 'play')}
      </button>
    </div>
  </Fragment>
  <script
    type="application/json"
    is:inline
    data-labels
    set:html={JSON.stringify({ ...L, play: t(lang, 'play'), pause: t(lang, 'pause') })}
  />
</VizFrame>

<style>
  .route {
    fill: none;
    stroke: var(--hairline-strong);
    stroke-dasharray: 3 4;
  }
  .route-done {
    fill: none;
    stroke: var(--water);
    stroke-width: 1.6;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .end {
    fill: var(--ink-soft);
  }
  .gauge {
    fill: none;
    stroke: var(--hairline-strong);
  }
  .gauge-fill {
    fill: var(--lamp-line);
    transform-box: fill-box;
    transform-origin: left;
  }
</style>

<script>
  for (const fig of document.querySelectorAll<HTMLElement>('[data-viz="godwit"]')) {
    const L: Record<string, string> = JSON.parse(fig.querySelector('[data-labels]')!.textContent!);
    const range = fig.querySelector<HTMLInputElement>('[data-progress]')!;
    const play = fig.querySelector<HTMLButtonElement>('[data-play]')!;
    const route = fig.querySelector<SVGPathElement>('.route')!;
    const done = fig.querySelector('.route-done')!;
    const bird = fig.querySelector('.bird')!;
    const fill = fig.querySelector<SVGRectElement>('.gauge-fill')!;
    const out = fig.querySelector('[data-readout]')!;
    const total = route.getTotalLength();
    const lang = document.documentElement.lang;
    const TOTAL_HOURS = 11 * 24 + 1; // 11 days and 1 hour
    const TOTAL_KM = 13560;
    let raf = 0;

    const draw = () => {
      const f = Number(range.value);
      const pt = route.getPointAtLength(total * f);
      bird.setAttribute('cx', String(pt.x));
      bird.setAttribute('cy', String(pt.y));
      done.setAttribute('stroke-dashoffset', String(1 - f));
      fill.style.transform = `scaleX(${1 - f})`;
      const hours = Math.round(TOTAL_HOURS * f);
      out.textContent = L.readout
        .replace('{d}', String(Math.floor(hours / 24)))
        .replace('{h}', String(hours % 24))
        .replace('{km}', Math.round(TOTAL_KM * f).toLocaleString(lang));
    };
    const stop = () => {
      cancelAnimationFrame(raf);
      raf = 0;
      play.setAttribute('aria-pressed', 'false');
      play.textContent = L.play;
    };
    // One day of the flight per second: slow enough to read the counter.
    const step = (prev: number) => (now: number) => {
      const next = Number(range.value) + (now - prev) / 1000 / 11.04 / 1;
      range.value = String(Math.min(1, next));
      draw();
      if (next >= 1) stop();
      else raf = requestAnimationFrame(step(now));
    };
    play.addEventListener('click', () => {
      if (raf) return stop();
      if (Number(range.value) >= 1) range.value = '0';
      play.setAttribute('aria-pressed', 'true');
      play.textContent = L.pause;
      raf = requestAnimationFrame(step(performance.now()));
    });
    range.addEventListener('input', () => {
      stop();
      draw();
    });
    draw();
  }
</script>
