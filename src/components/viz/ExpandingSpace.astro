---
// S23 · "And the heaven We constructed with strength, and indeed, We are [its]
// expander" (51:47). On the page: since Hubble (1929) we know the universe
// expands in all directions; the rate, the Hubble constant, is 67–68 km/s per
// megaparsec from the early universe (Planck) but 73–74 from the nearby
// universe (Hubble, Gaia): the "Hubble tension". Space stretches: every dot sees
// every other dot move away, and farther ones faster (the constant is a speed
// per distance). The classical commentators did not read 51:47 this way; the
// page says so. Breathes in view; with reduced motion, a slider.
import VizFrame from '../VizFrame.astro';
import type { Locale } from '../../i18n/ui';
interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const L =
  lang === 'tr'
    ? {
        title: 'Uzay genişler: her nokta ötekilerden uzaklaşır',
        you: 'herhangi bir nokta',
        near: 'yakın: yavaş',
        far: 'uzak: hızlı',
        stretch: 'Genişleme',
        tension: 'Genişleme hızı (km/s / megaparsek)',
        early: 'erken evren (Planck)',
        nearby: 'yakın evren (Hubble, Gaia)',
        text: 'Hubble 1929\'da evrenin her yönde genişlediğine dair ilk gözlemsel kanıtı sundu. Genişleme hızı (Hubble sabiti) erken evrenden 67–68, yakın evrenden 73–74 km/s/megaparsek çıkar; bu uyuşmazlığa "Hubble gerilimi" denir. Genişlemede her nokta ötekilerin uzaklaştığını görür; uzaktakiler daha hızlı uzaklaşır. Klasik müfessirler 51:47\'yi böyle okumamıştır.',
      }
    : {
        title: 'Space stretches: every point sees the others move away',
        you: 'any point',
        near: 'near: slower',
        far: 'far: faster',
        stretch: 'Stretch',
        tension: 'Expansion rate (km/s per megaparsec)',
        early: 'early universe (Planck)',
        nearby: 'nearby universe (Hubble, Gaia)',
        text: 'In 1929 Hubble presented the first observational evidence that the universe is expanding in all directions. The expansion rate, the Hubble constant, comes out at 67–68 km/s per megaparsec from the early universe but 73–74 from the nearby universe: the "Hubble tension". As space stretches, every point sees every other point move away, and farther ones faster. The classical commentators did not read 51:47 this way.',
      };
const pts = [
  [0, 0],
  [40, -20],
  [-50, 18],
  [70, 30],
  [-30, -46],
  [20, 54],
  [-80, -24],
  [96, -40],
  [-100, 44],
  [60, -64],
  [-64, 70],
  [110, 66],
];
---

<VizFrame lang={lang} title={L.title} textVersion={L.text} kind="expand">
  <svg viewBox="-170 -110 340 220" aria-hidden="true" focusable="false" class="xs" data-xs>
    <g data-grid>
      {[-2, -1, 0, 1, 2].map((i) => (
        <line x1={i * 50} y1="-100" x2={i * 50} y2="100" class="xs__grid" />
      ))}
      {[-2, -1, 0, 1, 2].map((i) => (
        <line x1="-120" y1={i * 40} x2="120" y2={i * 40} class="xs__grid" />
      ))}
    </g>
    {pts.map(([x, y], i) => (
      <g data-pt data-x={x} data-y={y}>
        {i > 0 && <line x1="0" y1="0" x2={x} y2={y} class="xs__ray" data-ray />}
        <circle cx={x} cy={y} r={i === 0 ? 5 : 3.5} class={i === 0 ? 'xs__you' : 'xs__gal'} />
      </g>
    ))}
    <text x="8" y="-8" class="v-text">
      {L.you}
    </text>
    <text x="-160" y="104" class="v-text v-text--soft">
      {L.near} · {L.far}
    </text>
  </svg>
  <Fragment slot="controls">
    <label class="xs__label">
      {L.stretch}
      <input type="range" min="0" max="100" value="0" data-stretch />
    </label>
    <div class="xs__tension">
      <p class="xs__tension-title">{L.tension}</p>
      <div class="xs__bar">
        <span style="--a:67;--b:68" class="xs__seg xs__seg--a"></span>
        <span style="--a:73;--b:74" class="xs__seg xs__seg--b"></span>
      </div>
      <div class="xs__legend">
        <span>
          <b>67–68</b> {L.early}
        </span>
        <span>
          <b>73–74</b> {L.nearby}
        </span>
      </div>
    </div>
  </Fragment>
</VizFrame>

<script>
  for (const fig of document.querySelectorAll<HTMLElement>('[data-viz="expand"]')) {
    const pts = [...fig.querySelectorAll<SVGGElement>('[data-pt]')].map((g) => ({
      g,
      x: Number(g.dataset.x),
      y: Number(g.dataset.y),
      dot: g.querySelector('circle')!,
      ray: g.querySelector<SVGLineElement>('[data-ray]'),
    }));
    const grid = fig.querySelector<SVGGElement>('[data-grid]')!;
    const slider = fig.querySelector<HTMLInputElement>('[data-stretch]')!;
    // Scale 1 → 1.45: every distance grows by the same factor, so a point twice
    // as far moves twice as much in the same time.
    const set = (v: number) => {
      const s = 1 + 0.45 * (v / 100);
      grid.setAttribute('transform', `scale(${s.toFixed(3)})`);
      for (const p of pts) {
        p.dot.setAttribute('cx', (p.x * s).toFixed(1));
        p.dot.setAttribute('cy', (p.y * s).toFixed(1));
        p.ray?.setAttribute('x2', (p.x * s).toFixed(1));
        p.ray?.setAttribute('y2', (p.y * s).toFixed(1));
      }
      slider.value = String(Math.round(v));
    };
    slider.addEventListener('input', () => ((stop = true), set(Number(slider.value))));
    let stop = false;
    set(0);
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const io = new IntersectionObserver(
        (e) => {
          if (!e.some((x) => x.isIntersecting)) return;
          io.disconnect();
          const t0 = performance.now();
          const step = (now: number) => {
            if (stop) return;
            const p = ((now - t0) / 6000) % 2;
            set((p < 1 ? p : 2 - p) * 100);
            requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        },
        { threshold: 0.5 },
      );
      io.observe(fig);
    }
  }
</script>

<style>
  .xs {
    width: 100%;
    max-width: 34rem;
    display: block;
    margin: 0 auto;
    background: color-mix(in srgb, var(--cobalt) 6%, var(--paper));
    border-radius: var(--radius);
  }
  .xs__grid {
    stroke: var(--hairline);
    stroke-width: 0.6;
    vector-effect: non-scaling-stroke;
  }
  .xs__ray {
    stroke: var(--turquoise);
    stroke-width: 0.7;
    stroke-dasharray: 2 3;
  }
  .xs__you {
    fill: var(--clay);
  }
  .xs__gal {
    fill: var(--cobalt);
  }
  .v-text {
    font-family: var(--font-ui);
    font-size: 9px;
    fill: var(--ink);
  }
  .v-text--soft {
    fill: var(--ink-soft);
  }
  .xs__label {
    display: flex;
    flex-direction: column;
    font-family: var(--font-ui);
    font-size: var(--step--1);
  }
  .xs__label input {
    accent-color: var(--lamp);
  }
  .xs__tension {
    margin-top: var(--space-3);
    font-family: var(--font-ui);
    font-size: var(--step--1);
  }
  .xs__tension-title {
    margin: 0 0 var(--space-1);
    color: var(--ink-soft);
  }
  /* A scale from 60 to 80: the two measured ranges do not overlap. */
  .xs__bar {
    position: relative;
    height: 0.6rem;
    background: var(--hairline);
    border-radius: 999px;
  }
  .xs__seg {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc((var(--a) - 60) * 5%);
    width: calc((var(--b) - var(--a)) * 5%);
    border-radius: 999px;
  }
  .xs__seg--a {
    background: var(--cobalt);
  }
  .xs__seg--b {
    background: var(--clay);
  }
  .xs__legend {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    margin-top: var(--space-1);
    color: var(--ink-soft);
  }
</style>
