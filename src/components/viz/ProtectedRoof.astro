---
// S25 · "And We made the sky a protected ceiling" (21:32). Three of the ways the
// page describes: the ozone layer absorbs much of the Sun's ultraviolet light;
// the magnetic field keeps solar plasma away from the surface; most small
// meteoroids burn up high in the air. Qualitative only, as on the page: no
// heights or figures are drawn. Loops in view; with reduced motion, still.
import VizFrame from '../VizFrame.astro';
import type { Locale } from '../../i18n/ui';
interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const L =
  lang === 'tr'
    ? {
        title: 'Korunan tavan: üç koruma',
        uv: 'morötesi ışık',
        ozone: 'ozon tabakası emer',
        wind: 'güneş rüzgârı',
        field: 'manyetik alan saptırır',
        meteor: 'göktaşları havada yanar',
        earth: 'Dünya',
        scale: 'Ölçekli değildir; yükseklikler gösterilmez.',
        text: 'Ozon tabakası Güneş\'in morötesi ışığının büyük kısmını emer. Dünya\'nın manyetik alanı güneş plazmasını yüzeyden uzak tutar. Küçük göktaşlarının çoğu atmosferin yükseklerinde "kayan yıldız" olarak yanar. Çizim ölçekli değildir.',
      }
    : {
        title: 'A protected ceiling: three kinds of protection',
        uv: 'ultraviolet light',
        ozone: 'the ozone layer absorbs it',
        wind: 'solar wind',
        field: 'the magnetic field turns it aside',
        meteor: 'meteors burn up in the air',
        earth: 'Earth',
        scale: 'Not to scale; no heights shown.',
        text: 'The ozone layer absorbs much of the Sun\'s ultraviolet light. Earth\'s magnetic field keeps solar plasma away from the surface. Most small meteoroids burn up high in the atmosphere as "shooting stars". The drawing is not to scale.',
      };
---

<VizFrame lang={lang} title={L.title} textVersion={L.text} kind="roof">
  <svg viewBox="0 0 340 220" aria-hidden="true" focusable="false" class="pr">
    <path d="M-20 220 A190 120 0 0 1 360 220 Z" class="pr__air" />
    <path d="M10 220 A160 96 0 0 1 330 220" class="pr__ozone" />
    <path d="M50 220 A120 70 0 0 1 290 220 Z" class="pr__earth" />
    <text x="170" y="196" class="v-text" text-anchor="middle">
      {L.earth}
    </text>
    <!-- UV: arrows that stop at the ozone band -->
    <g class="pr__uv">
      {[60, 90, 120].map((x, i) => (
        <line x1={x} y1="16" x2={x + 14} y2="104" style={`--d:${i * 0.4}s`} />
      ))}
    </g>
    <!-- Solar wind: particles that curve away -->
    <g class="pr__wind">
      {[0, 1, 2, 3].map((i) => (
        <circle r="2.4" style={`--d:${i * 0.6}s`} />
      ))}
    </g>
    <path d="M200 30 C240 20 300 40 330 90" class="pr__field" />
    <path d="M190 50 C230 44 280 60 310 100" class="pr__field" />
    <!-- Meteors: short streaks that fade -->
    <g class="pr__meteors">
      {[
        [150, 30],
        [176, 46],
        [130, 52],
      ].map(([x, y], i) => (
        <line x1={x} y1={y} x2={x + 10} y2={y + 26} style={`--d:${i * 1.1}s`} />
      ))}
    </g>
    <text x="4" y="10" class="v-text v-text--soft">
      {L.scale}
    </text>
  </svg>
  <Fragment slot="controls">
    <ul class="pr__legend">
      <li>
        <span class="pr__key pr__key--uv"></span>
        {L.uv}: {L.ozone}
      </li>
      <li>
        <span class="pr__key pr__key--wind"></span>
        {L.wind}: {L.field}
      </li>
      <li>
        <span class="pr__key pr__key--meteor"></span>
        {L.meteor}
      </li>
    </ul>
  </Fragment>
</VizFrame>

<style>
  .pr {
    width: 100%;
    max-width: 36rem;
    display: block;
    margin: 0 auto;
  }
  .pr__air {
    fill: color-mix(in srgb, var(--water) 14%, var(--paper));
  }
  .pr__ozone {
    fill: none;
    stroke: var(--turquoise);
    stroke-width: 6;
    opacity: 0.6;
  }
  .pr__earth {
    fill: color-mix(in srgb, var(--life) 45%, var(--paper));
  }
  .pr__uv line {
    stroke: var(--clay);
    stroke-width: 1.4;
    stroke-dasharray: 4 3;
  }
  .pr__wind circle {
    fill: var(--lamp-line);
    offset-path: path('M330 10 C280 20 250 30 230 30 C250 40 300 60 340 110');
  }
  .pr__field {
    fill: none;
    stroke: var(--cobalt);
    stroke-width: 1;
    stroke-dasharray: 2 3;
  }
  .pr__meteors line {
    stroke: var(--lamp-line);
    stroke-width: 1.6;
    stroke-linecap: round;
  }
  @media (prefers-reduced-motion: no-preference) {
    .pr__uv line {
      animation: pr-dash 1.2s var(--d) linear infinite;
    }
    .pr__wind circle {
      animation: pr-wind 2.4s var(--d) linear infinite;
    }
    .pr__meteors line {
      animation: pr-meteor 3.3s var(--d) ease-in infinite;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pr__wind circle {
      offset-distance: 60%;
    }
  }
  @keyframes pr-dash {
    to {
      stroke-dashoffset: -14;
    }
  }
  @keyframes pr-wind {
    from {
      offset-distance: 0%;
    }
    to {
      offset-distance: 100%;
    }
  }
  @keyframes pr-meteor {
    0% {
      opacity: 0;
      transform: translate(0, 0);
    }
    10% {
      opacity: 1;
    }
    40% {
      opacity: 0;
      transform: translate(8px, 22px);
    }
    100% {
      opacity: 0;
    }
  }
  .pr__legend {
    list-style: none;
    padding: 0;
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--step--1);
    display: grid;
    gap: var(--space-1);
  }
  .pr__legend li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .pr__key {
    flex: none;
    width: 1.4rem;
    height: 0;
    border-top: 2px dashed var(--clay);
  }
  .pr__key--wind {
    width: 0.6rem;
    height: 0.6rem;
    border: 0;
    border-radius: 50%;
    background: var(--lamp-line);
  }
  .pr__key--meteor {
    border-top: 2px solid var(--lamp-line);
  }
  .v-text {
    font-family: var(--font-ui);
    font-size: 9px;
    fill: var(--ink);
  }
  .v-text--soft {
    fill: var(--ink-soft);
  }
</style>
