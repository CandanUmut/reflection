---
// S5 · "each, in an orbit, is swimming" (36:40) and "We have determined for it
// phases" (36:39). The Earth goes round the Sun, the Moon round the Earth. After
// 27.3 days the Moon is back in line with the same distant star; but the Earth
// has moved on, so the Moon needs about two more days to line up with the Sun
// again: new moon, a new month, every 29.5 days. Not to scale. Plays when it
// scrolls into view; with reduced motion it waits, and the slider always works.
import VizFrame from '../VizFrame.astro';
import type { Locale } from '../../i18n/ui';
interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const L =
  lang === 'tr'
    ? {
        title: "Her biri bir yörüngede yüzer — Ay'ın evreleri neden 29,5 gün sürer",
        sun: 'Güneş',
        earth: 'Dünya',
        moon: 'Ay',
        star: 'uzak bir yıldıza doğru',
        seen: "Dünya'dan görünen",
        day: 'Gün',
        play: 'Oynat',
        pause: 'Durdur',
        restart: 'Baştan',
        sidereal: '27,3 gün: Ay aynı uzak yıldızla yeniden aynı hizada — ama henüz yeni ay değil.',
        synodic:
          "29,5 gün: yeni ay. Dünya bu arada ilerlediği için Ay'ın Güneş'le hizalanması iki gün daha sürdü. Yeni bir ay başlıyor (36:39).",
        scale: 'Ölçekli değildir.',
        text: "Dünya Güneş'in çevresinde, Ay da Dünya'nın çevresinde döner. Ay, uzak bir yıldıza göre aynı konuma 27,3 günde döner. Ancak bu sürede Dünya da yörüngesinde ilerlediği için Ay'ın yeniden Güneş ile Dünya arasına gelmesi (yeni ay) yaklaşık 29,5 gün sürer. Hicri ayın uzunluğu budur. Çizim ölçekli değildir.",
      }
    : {
        title: "Each, in an orbit, is swimming — why the Moon's phases take 29.5 days",
        sun: 'Sun',
        earth: 'Earth',
        moon: 'Moon',
        star: 'towards a distant star',
        seen: 'Seen from Earth',
        day: 'Day',
        play: 'Play',
        pause: 'Pause',
        restart: 'Restart',
        sidereal: '27.3 days: the Moon is back in line with the same distant star — but it is not new moon yet.',
        synodic:
          '29.5 days: new moon. Because the Earth moved on meanwhile, the Moon needed about two more days to line up with the Sun again. A new month begins (36:39).',
        scale: 'Not to scale.',
        text: 'The Earth goes round the Sun, and the Moon round the Earth. The Moon returns to the same place against a distant star in 27.3 days. But in that time the Earth has moved along its own orbit, so the Moon needs about 29.5 days to come back between the Earth and the Sun (new moon). That is the length of an Islamic month. The drawing is not to scale.',
      };
---

<VizFrame lang={lang} title={L.title} textVersion={L.text} kind="orbit">
  <svg viewBox="0 0 370 250" aria-hidden="true" focusable="false" class="orbit">
    <defs>
      <radialGradient id="orbit-sun" r="0.6">
        <stop offset="0" stop-color="var(--lamp-line)" />
        <stop offset="1" stop-color="var(--lamp)" />
      </radialGradient>
    </defs>
    <circle cx="150" cy="130" r="98" class="orbit__path" />
    <circle cx="150" cy="130" r="18" fill="url(#orbit-sun)" class="orbit__sun" />
    <text x="150" y="160" class="v-text" text-anchor="middle">
      {L.sun}
    </text>
    <g data-earth>
      <circle r="30" class="orbit__path orbit__path--moon" />
      <line x1="0" y1="0" x2="0" y2="48" class="orbit__star" data-star />
      <text x="4" y="58" class="v-text v-text--soft">
        ↓ {L.star}
      </text>
      <circle r="8" class="orbit__earth" />
      <g data-moon>
        <circle r="5.5" class="orbit__moon-dark" />
        <path d="M0 -5.5 A5.5 5.5 0 0 1 0 5.5 Z" class="orbit__moon-lit" data-moon-lit />
      </g>
    </g>
    <text x="0" y="0" class="v-text" data-earth-label>
      {L.earth}
    </text>
    <g transform="translate(325 196)">
      <circle r="26" class="orbit__moon-dark" />
      <path class="orbit__moon-lit" d="" data-phase />
      <circle r="26" class="orbit__rim" />
      <text y="42" class="v-text" text-anchor="middle">
        {L.seen}
      </text>
    </g>
    <text x="8" y="244" class="v-text v-text--soft">
      {L.scale}
    </text>
  </svg>
  <Fragment slot="controls">
    <p class="viz__readout" aria-live="polite" data-readout>
      &nbsp;
    </p>
    <div class="orbit__controls">
      <button type="button" class="btn" data-play data-play-label={L.play} data-pause-label={L.pause}>
        {L.play}
      </button>
      <button type="button" class="btn" data-restart>
        {L.restart}
      </button>
      <label class="orbit__day">
        <span>
          {L.day} <output data-day-out>0</output>
        </span>
        <input type="range" min="0" max="60" step="0.1" value="0" data-day />
      </label>
    </div>
  </Fragment>
  <script
    type="application/json"
    is:inline
    data-orbit-labels
    set:html={JSON.stringify({ sidereal: L.sidereal, synodic: L.synodic, lang })}
  />
</VizFrame>

<script>
  const SIDEREAL = 27.32;
  const SYNODIC = 29.53;
  const YEAR = 365.25;
  for (const fig of document.querySelectorAll<HTMLElement>('[data-viz="orbit"]')) {
    const L = JSON.parse(fig.querySelector('[data-orbit-labels]')!.textContent!);
    const earth = fig.querySelector<SVGGElement>('[data-earth]')!;
    const moon = fig.querySelector<SVGGElement>('[data-moon]')!;
    const lit = fig.querySelector<SVGPathElement>('[data-moon-lit]')!;
    const phase = fig.querySelector<SVGPathElement>('[data-phase]')!;
    const earthLabel = fig.querySelector<SVGTextElement>('[data-earth-label]')!;
    const slider = fig.querySelector<HTMLInputElement>('[data-day]')!;
    const out = fig.querySelector<HTMLOutputElement>('[data-day-out]')!;
    const readout = fig.querySelector<HTMLElement>('[data-readout]')!;
    const play = fig.querySelector<HTMLButtonElement>('[data-play]')!;
    const fmt = new Intl.NumberFormat(L.lang === 'tr' ? 'tr-TR' : 'en-US', {
      maximumFractionDigits: 1,
      minimumFractionDigits: 1,
    });
    const E0 = -Math.PI / 2; // the Earth starts above the Sun
    // The phase disc as seen from Earth: p = 0 new, 0.5 full.
    const disc = (p: number, r = 26) => {
      const rx = r * Math.abs(Math.cos(2 * Math.PI * p));
      const waxing = p < 0.5;
      const gibbous = p > 0.25 && p < 0.75;
      return `M0 ${-r} A${r} ${r} 0 0 ${waxing ? 1 : 0} 0 ${r} A${rx} ${r} 0 0 ${gibbous === waxing ? 1 : 0} 0 ${-r}Z`;
    };
    let t = 0;
    let last = '';
    const draw = () => {
      const e = E0 + (2 * Math.PI * t) / YEAR;
      const ex = 150 + 98 * Math.cos(e);
      const ey = 130 + 98 * Math.sin(e);
      earth.setAttribute('transform', `translate(${ex.toFixed(2)} ${ey.toFixed(2)})`);
      earthLabel.setAttribute('x', (ex + 12).toFixed(1));
      earthLabel.setAttribute('y', (ey - 12).toFixed(1));
      // At t = 0 the Moon sits between the Earth and the Sun: new moon. Its turn is
      // measured against the fixed stars (27.3 days), not against the moving Sun.
      const m = E0 + Math.PI + (2 * Math.PI * t) / SIDEREAL;
      moon.setAttribute('transform', `translate(${(30 * Math.cos(m)).toFixed(2)} ${(30 * Math.sin(m)).toFixed(2)})`);
      // The lit half of the small Moon faces the Sun.
      const toSun = Math.atan2(130 - (ey + 30 * Math.sin(m)), 150 - (ex + 30 * Math.cos(m)));
      lit.setAttribute('transform', `rotate(${((toSun * 180) / Math.PI).toFixed(1)})`);
      // The star line keeps one direction (a distant star does not move): it points
      // where the Moon was at the start, so after 27.3 days the Moon is back on it.
      const p = (((t % SYNODIC) + SYNODIC) % SYNODIC) / SYNODIC;
      phase.setAttribute('d', disc(p));
      slider.value = String(t);
      out.textContent = fmt.format(t);
      const msg = t >= SYNODIC - 0.15 ? L.synodic : t >= SIDEREAL - 0.15 ? L.sidereal : '';
      if (msg !== last) {
        readout.textContent = msg || '\u00a0';
        last = msg;
      }
    };
    let running = false;
    let prev = 0;
    const tick = (now: number) => {
      if (!running) return;
      const dt = Math.min(0.05, (now - prev) / 1000);
      prev = now;
      // Slow down near the two moments that matter, so they can be seen.
      const near = Math.abs(t - SIDEREAL) < 1.2 || Math.abs(t - SYNODIC) < 1.2;
      t += dt * (near ? 1.6 : 5.5);
      if (t >= 32) {
        t = 32;
        stop();
      }
      draw();
      if (running) requestAnimationFrame(tick);
    };
    const start = () => {
      if (t >= 32) t = 0;
      running = true;
      prev = performance.now();
      play.textContent = play.dataset.pauseLabel!;
      requestAnimationFrame(tick);
    };
    const stop = () => {
      running = false;
      play.textContent = play.dataset.playLabel!;
    };
    play.addEventListener('click', () => (running ? stop() : start()));
    fig.querySelector('[data-restart]')!.addEventListener('click', () => {
      t = 0;
      last = 'x';
      draw();
      start();
    });
    slider.addEventListener('input', () => {
      stop();
      t = Number(slider.value);
      draw();
    });
    draw();
    // Plays once when it comes into view, unless the reader prefers reduced motion.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            io.disconnect();
            start();
          }
        },
        { threshold: 0.5 },
      );
      io.observe(fig);
    }
  }
</script>

<style>
  .orbit {
    width: 100%;
    max-width: 36rem;
    display: block;
    margin: 0 auto;
  }
  .orbit__path {
    fill: none;
    stroke: var(--hairline-strong);
    stroke-width: 0.8;
    stroke-dasharray: 2 4;
  }
  .orbit__path--moon {
    stroke-dasharray: 1.5 3;
  }
  .orbit__sun {
    filter: drop-shadow(0 0 6px color-mix(in srgb, var(--lamp-line) 60%, transparent));
  }
  .orbit__earth {
    fill: var(--cobalt);
  }
  .orbit__star {
    stroke: var(--turquoise);
    stroke-width: 1;
    stroke-dasharray: 3 3;
  }
  .orbit__moon-dark {
    fill: var(--hairline-strong);
    stroke: var(--ink-soft);
    stroke-width: 0.6;
  }
  /* The lit part of the Moon is light, the unlit part dark, in every palette. */
  .orbit__moon-lit {
    fill: var(--lamp-line);
  }
  .orbit__rim {
    fill: none;
    stroke: var(--ink-soft);
    stroke-width: 1;
  }
  .v-text {
    font-family: var(--font-ui);
    font-size: 9px;
    fill: var(--ink);
  }
  .v-text--soft {
    fill: var(--ink-soft);
  }
  .orbit__controls {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
  }
  .orbit__day {
    display: flex;
    flex-direction: column;
    flex: 1 1 12rem;
    font-family: var(--font-ui);
    font-size: var(--step--1);
  }
  .orbit__day input {
    width: 100%;
    accent-color: var(--lamp);
  }
</style>
