---
// S14 · Shadows. A stick in the ground, seen from the south. Move the time of
// day and the season: the drawn shadow is its true east–west part, so it
// swings smoothly through noon; the readout gives its full length. ʿAṣr
// markers: majority, shadow = length + noon shadow (research S14); Ḥanafī,
// twice the length + noon shadow (the usual fiqh wording; the research says
// only "twice the length" — logged in CONTENT_GAPS). Length = h / tan(elev).
// No autoplay: the reader moves the sun.
import VizFrame from '../VizFrame.astro';
import type { Locale } from '../../i18n/ui';
interface Props {
  lang: Locale;
  title: string;
  textVersion?: string | undefined;
  labels: Record<string, string>;
}
const { lang, title, textVersion, labels: L } = Astro.props;
---

<VizFrame lang={lang} title={title} textVersion={textVersion} kind="sundial">
  <svg viewBox="0 0 320 190" aria-hidden="true" focusable="false">
    <path class="sun-arc" d="" />
    <circle class="sun v-lamp" cx="160" cy="40" r="7" />
    <line class="v-ground" x1="0" y1="150" x2="320" y2="150" />
    <line class="shadow" x1="160" y1="150" x2="160" y2="150" />
    <line class="stick" x1="160" y1="150" x2="160" y2="110" />
    <text class="v-text" x="4" y="170">
      {L.west}
    </text>
    <text class="v-text" x="316" y="170" text-anchor="end">
      {L.east}
    </text>
    <text class="v-text asr-mark" x="160" y="184" text-anchor="middle"></text>
  </svg>
  <Fragment slot="controls">
    <p class="viz__readout" aria-live="polite" data-readout></p>
    <label>
      {L.time} <span data-time-out></span>
      <input type="range" min="5" max="19" step="0.1" value="9" data-time />
    </label>
    <div class="viz__row" role="radiogroup" aria-label={L.season}>
      <span>{L.season}:</span>
      <label class="choice">
        <input type="radio" name="sd-season" value="23.44" /> {L.summer}
      </label>
      <label class="choice">
        <input type="radio" name="sd-season" value="0" checked /> {L.equinox}
      </label>
      <label class="choice">
        <input type="radio" name="sd-season" value="-23.44" /> {L.winter}
      </label>
    </div>
    <div class="viz__row" role="radiogroup" aria-label={L.place}>
      <span>{L.place}:</span>
      <label class="choice">
        <input type="radio" name="sd-place" value="41" checked /> {L.istanbul}
      </label>
      <label class="choice">
        <input type="radio" name="sd-place" value="21.4" /> {L.mecca}
      </label>
    </div>
  </Fragment>
  <script type="application/json" is:inline data-labels set:html={JSON.stringify(L)} />
</VizFrame>

<style>
  .sun-arc {
    fill: none;
    stroke: var(--hairline);
    stroke-dasharray: 2 4;
  }
  .stick {
    stroke: var(--ink);
    stroke-width: 2.5;
    stroke-linecap: round;
  }
  .shadow {
    stroke: var(--ink-soft);
    stroke-width: 5;
    stroke-linecap: round;
  }
  .choice {
    display: inline-flex !important;
    align-items: center;
    gap: var(--space-1);
    min-height: 2.75rem;
  }
  .choice input {
    accent-color: var(--water);
  }
  .asr-mark {
    fill: var(--lamp);
  }
</style>

<script>
  const rad = Math.PI / 180;
  for (const fig of document.querySelectorAll<HTMLElement>('[data-viz="sundial"]')) {
    const L: Record<string, string> = JSON.parse(fig.querySelector('[data-labels]')!.textContent!);
    const time = fig.querySelector<HTMLInputElement>('[data-time]')!;
    const out = fig.querySelector('[data-readout]')!;
    const timeOut = fig.querySelector('[data-time-out]')!;
    const sun = fig.querySelector('.sun')!;
    const shadow = fig.querySelector('.shadow')!;
    const asrMark = fig.querySelector('.asr-mark')!;
    const UNIT = 40; // the stick is 40 px tall
    const fmt = (x: number) => x.toLocaleString(document.documentElement.lang, { maximumFractionDigits: 1 });

    const arc = fig.querySelector('.sun-arc')!;
    // Sun direction in east/north/up for a given hour angle (unit stick, unit sky).
    const sunAt = (lat: number, dec: number, hour: number) => {
      const up = Math.sin(lat) * Math.sin(dec) + Math.cos(lat) * Math.cos(dec) * Math.cos(hour);
      const east = -Math.cos(dec) * Math.sin(hour);
      return { up, east };
    };
    // East is to the right, west to the left (seen from the south).
    const skyX = (east: number) => 160 + east * 140;
    const skyY = (up: number) => 150 - up * 125;

    const draw = () => {
      const t = Number(time.value);
      const dec = Number(fig.querySelector<HTMLInputElement>('input[name="sd-season"]:checked')!.value) * rad;
      const lat = Number(fig.querySelector<HTMLInputElement>('input[name="sd-place"]:checked')!.value) * rad;
      const hour = (t - 12) * 15 * rad;
      const { up, east } = sunAt(lat, dec, hour);
      const elev = Math.asin(up);
      const noonShadow = Math.tan(Math.abs(lat - dec));
      const hh = Math.floor(t);
      const clock = `${String(hh).padStart(2, '0')}:${String(Math.round((t - hh) * 60)).padStart(2, '0')}`;
      timeOut.textContent = clock;
      // The sun's path for this season, drawn where it is above the horizon.
      const pts: string[] = [];
      for (let h = -180; h <= 180; h += 5) {
        const p = sunAt(lat, dec, h * rad);
        if (p.up >= 0) pts.push(`${skyX(p.east).toFixed(1)} ${skyY(p.up).toFixed(1)}`);
      }
      arc.setAttribute('d', pts.length ? 'M' + pts.join(' L') : '');
      if (elev <= 0) {
        sun.setAttribute('visibility', 'hidden');
        shadow.setAttribute('x2', '160');
        out.textContent = L.below;
        asrMark.textContent = '';
        time.setAttribute('aria-valuetext', `${clock}. ${L.below}`);
        return;
      }
      sun.setAttribute('visibility', 'visible');
      sun.setAttribute('cx', String(skyX(east)));
      sun.setAttribute('cy', String(skyY(up)));
      const len = 1 / Math.tan(elev);
      // The shadow points away from the sun: its east–west part is −east / up.
      const ew = -east / up;
      shadow.setAttribute('x2', String(160 + Math.max(-158, Math.min(158, ew * UNIT))));
      let text = len < 0.05 ? L.almostNone : L.ratio.replace('{x}', fmt(len));
      if (Math.abs(ew * UNIT) > 158) text += ' ' + L.long;
      if (Math.abs(t - 12) < 0.05) text += ' ' + L.noon;
      out.textContent = text;
      let mark = '';
      if (t > 12 && len >= 2 + noonShadow) mark = L.asrHanafi;
      else if (t > 12 && len >= 1 + noonShadow) mark = L.asr;
      asrMark.textContent = mark;
      time.setAttribute('aria-valuetext', `${clock}. ${text} ${mark}`.trim());
    };
    fig.addEventListener('input', draw);
    draw();
  }
</script>
