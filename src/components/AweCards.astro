---
// "Points of awe" as cards. The first number in each fact is set large and,
// when the card scrolls into view, counts up to its value (unless the reader
// prefers reduced motion). The full fact, with its source, stays as written.
import { md, mdInline } from '../lib/md';
import type { Locale } from '../i18n/ui';
interface Props {
  text: string;
  lang: Locale;
}
const { text, lang } = Astro.props;
const items = text
  .split(/^- /m)
  .map((x) => x.trim())
  .filter(Boolean);
// A number with an optional unit right after it: "29.5 days", "230 km/s", "240%", "1,990".
const NUM =
  /(\d{1,3}(?:[,.]\d{3})+|\d+(?:[.,]\d+)?)(\s?(?:%|°C|km\/s|km\/h|km|cm|mm|m|kg|g|litres?|L|days?|years?|hours?|minutes?|million|billion|times))?/;
const cards = items.map((t) => {
  const m = t.match(NUM);
  if (!m) return { t };
  const raw = m[1];
  // "1,990" is a thousands separator in English; "29,5" a decimal comma in Turkish.
  const value = lang === 'tr' ? Number(raw.replace(/\./g, '').replace(',', '.')) : Number(raw.replace(/,/g, ''));
  const decimals = (raw.split(lang === 'tr' ? ',' : '.')[1] ?? '').length;
  return Number.isFinite(value) ? { t, raw, value, decimals, unit: (m[2] ?? '').trim() } : { t };
});
---

<div class="awe">
  {cards.map((c) => (
    <figure class="awe__card">
      {'raw' in c && (
        <p class="awe__num" aria-hidden="true">
          <span data-count={c.value} data-decimals={c.decimals} data-lang={lang}>
            {c.raw}
          </span>
          {c.unit && <span class="awe__unit">{c.unit}</span>}
        </p>
      )}
      <figcaption>
        <Fragment set:html={'raw' in c ? mdInline(c.t, lang) : md(c.t, lang)} />
      </figcaption>
    </figure>
  ))}
</div>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const els = document.querySelectorAll<HTMLElement>('[data-count]');
  if (!reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          io.unobserve(e.target);
          const el = e.target as HTMLElement;
          const end = Number(el.dataset.count);
          const dec = Number(el.dataset.decimals);
          const fmt = new Intl.NumberFormat(el.dataset.lang === 'tr' ? 'tr-TR' : 'en-US', {
            minimumFractionDigits: dec,
            maximumFractionDigits: dec,
          });
          const final = el.textContent;
          const t0 = performance.now();
          const step = (now: number) => {
            const p = Math.min(1, (now - t0) / 1400);
            const eased = 1 - Math.pow(1 - p, 3);
            el.textContent = p < 1 ? fmt.format(end * eased) : final;
            if (p < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        }
      },
      { threshold: 0.6 },
    );
    els.forEach((el) => io.observe(el));
  }
</script>

<style>
  .awe {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-3);
    margin: var(--space-3) 0 var(--space-4);
  }
  .awe__card {
    margin: 0;
    padding: var(--space-3);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--paper);
    position: relative;
    overflow: hidden;
  }
  .awe__card::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: linear-gradient(var(--lamp-line), var(--turquoise));
  }
  .awe__num {
    margin: 0 0 var(--space-1);
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.6rem + 2vw, 2.8rem);
    line-height: 1;
    color: var(--cobalt);
    font-variant-numeric: tabular-nums;
  }
  .awe__unit {
    font-size: 0.45em;
    margin-left: 0.25em;
    color: var(--ink-soft);
    font-family: var(--font-ui);
  }
  figcaption {
    font-size: 0.9rem;
    color: var(--ink-soft);
    line-height: 1.5;
  }
  figcaption :global(p) {
    margin: 0;
  }
</style>
