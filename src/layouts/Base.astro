---
import '@fontsource-variable/literata/wght.css';
import '@fontsource-variable/literata/wght-italic.css';
import '@fontsource-variable/fraunces/soft.css';
import '@fontsource-variable/fraunces/soft-italic.css';
import '@fontsource-variable/inter/wght.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/amiri-quran/400.css';
import '../styles/global.css';
import { palettes } from '../styles/palettes.mjs';
import { paletteScript } from '../lib/palette-script';
import { t, otherLocale, type Locale } from '../i18n/ui';
import { localeUrl, url } from '../lib/paths';
import PaletteControl from '../components/PaletteControl.astro';
import { sectionUrl, type Section } from '../lib/routes';

interface Props {
  lang: Locale;
  title: string;
  description?: string;
  /** Path of the same page in the other language (e.g. "reflect/seed/"), for the language switch. */
  altPath?: string;
  /** Pages outside the locale tree (the design study) hide the language switch. */
  standalone?: boolean;
  /** The section this page belongs to, marked in the navigation. */
  section?: Section;
}
const { lang, title, description, altPath = '', standalone = false, section } = Astro.props;
const sections = [
  ['signs', 'sectionSigns'],
  ['morals', 'sectionMorals'],
  ['questions', 'sectionQuestions'],
] as const;
const other = otherLocale(lang);
const fullTitle = title === t(lang, 'siteName') ? title : `${title} · ${t(lang, 'siteName')}`;

// One source of truth for colors: palettes.mjs → CSS custom properties.
const vars = (p: Record<string, string>) =>
  Object.entries(p)
    .map(([k, v]) => `--${k}:${v}`)
    .join(';');
const paletteCss = [
  `:root{${vars(palettes.day)}}`,
  `@media (prefers-color-scheme: dark){:root:not([data-palette]){${vars(palettes.night)}}}`,
  ...Object.entries(palettes).map(([name, p]) => `:root[data-palette='${name}']{${vars(p)}}`),
].join('\n');
---

<!doctype html>
<html lang={lang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    {!standalone && <link rel="alternate" hreflang={other} href={localeUrl(other, altPath)} />}
    <script is:inline set:html={paletteScript} />
    <style is:global set:html={paletteCss} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t(lang, 'skip')}
    </a>
    <header class="site-header">
      <div class="wrap wrap--wide site-header__inner">
        <a class="site-name" href={standalone ? url('') : localeUrl(lang)}>
          <span>{t(lang, 'siteName')}</span>
          <span class="site-subtitle">{t(lang, 'siteSubtitle')}</span>
        </a>
        {!standalone && (
          <nav class="site-nav" aria-label={t(lang, 'navLabel')}>
            {sections.map(([key, label]) => (
              <a href={sectionUrl(key, lang)} aria-current={section === key ? 'page' : undefined}>
                {t(lang, label)}
              </a>
            ))}
          </nav>
        )}
        <div class="site-tools">
          {!standalone && (
            <a
              class="lang-switch"
              href={localeUrl(other, altPath)}
              hreflang={other}
              lang={other}
              title={t(lang, 'langSwitchLabel')}
            >
              {t(lang, 'langSwitch')}
            </a>
          )}
          <PaletteControl lang={lang} />
        </div>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap wrap--wide">
        <p>
          {t(lang, 'footerTexts')} <a href="https://tanzil.net">Tanzil Project · tanzil.net</a>.
          {t(lang, 'footerTranslit')} <a href="https://quran.com">Quran.com</a>.
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    border-bottom: var(--rule);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 4rem;
  }
  .site-name {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    flex-wrap: wrap;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 1.25rem;
  }
  .site-subtitle {
    font-family: var(--font-text);
    font-style: italic;
    font-size: 0.85rem;
    color: var(--ink-soft);
  }
  @media (max-width: 30rem) {
    .site-subtitle {
      display: none;
    }
  }
  .site-header__inner {
    flex-wrap: wrap;
  }
  .site-nav {
    display: flex;
    gap: var(--space-4);
    font-family: var(--font-ui);
    font-size: var(--step--1);
  }
  .site-nav a {
    text-decoration: none;
    color: var(--ink-soft);
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    border-bottom: 1px solid transparent;
  }
  .site-nav a:hover {
    color: var(--ink);
  }
  .site-nav a[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: var(--lamp);
  }
  @media (max-width: 40rem) {
    .site-nav {
      order: 3;
      width: 100%;
      justify-content: space-between;
      border-top: var(--rule);
      gap: var(--space-2);
    }
  }
  .site-tools {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .lang-switch {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    padding: var(--space-2);
    text-decoration: none;
    color: var(--ink-soft);
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
  }
  .lang-switch:hover {
    color: var(--ink);
  }
  main:focus {
    outline: none;
  }
  .site-footer {
    margin-top: var(--space-7);
    padding-block: var(--space-5);
    border-top: var(--rule);
    font-family: var(--font-ui);
    font-size: 0.8rem;
    color: var(--ink-soft);
  }
</style>
