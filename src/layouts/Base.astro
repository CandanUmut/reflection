---
// Latin faces are subsetted by scripts/subset-fonts.py (one stylesheet, ~450 KB
// for all faces instead of ~1.7 MB); Amiri Quran keeps its full Arabic set.
import '../styles/fonts.css';
import '../styles/amiri.css';
import amiri from '../../node_modules/@fontsource/amiri-quran/files/amiri-quran-arabic-400-normal.woff2?url';
import displayItalicA from '../styles/fonts/cormorant-italic-a.woff2?url';
import displayItalicB from '../styles/fonts/cormorant-italic-b.woff2?url';
import '../styles/global.css';
import { palettes } from '../styles/palettes.mjs';
import { paletteScript } from '../lib/palette-script';
import { t, otherLocale, type Locale } from '../i18n/ui';
import { localeUrl, url } from '../lib/paths';
import PaletteControl from '../components/PaletteControl.astro';
import TileBorder from '../components/motifs/TileBorder.astro';
import FloraDefs from '../components/motifs/FloraDefs.astro';
import { sectionUrl, type Section } from '../lib/routes';

interface Props {
  lang: Locale;
  title: string;
  description?: string;
  /** Path of the same page in the other language (e.g. "reflect/seed/"), for the language switch. */
  altPath?: string;
  /** Pages outside the locale tree (the design study) hide the language switch. */
  standalone?: boolean;
  /** The section this page belongs to, marked in the navigation. */
  section?: Section;
  /** Preload the Arabic font (pages that show verses). */
  arabic?: boolean;
  /** The Threshold: preload the verse of the day's italic face. */
  home?: boolean;
}
const {
  lang,
  title,
  description,
  altPath = '',
  standalone = false,
  section,
  arabic = false,
  home = false,
} = Astro.props;
const sections = [
  ['signs', 'sectionSigns'],
  ['morals', 'sectionMorals'],
  ['questions', 'sectionQuestions'],
] as const;
const other = otherLocale(lang);
// Absolute URLs for search engines and link previews.
const abs = (path: string) => new URL(path, Astro.site).href;
const fullTitle = title === t(lang, 'siteName') ? title : `${title} · ${t(lang, 'siteName')}`;

// One source of truth for colors: palettes.mjs → CSS custom properties.
const vars = (p: Record<string, string>) =>
  Object.entries(p)
    .map(([k, v]) => `--${k}:${v}`)
    .join(';');
const paletteCss = [
  `:root{${vars(palettes.day)}}`,
  `@media (prefers-color-scheme: dark){:root:not([data-palette]){${vars(palettes.night)}}}`,
  ...Object.entries(palettes).map(([name, p]) => `:root[data-palette='${name}']{${vars(p)}}`),
].join('\n');
---

<!doctype html>
<html lang={lang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {standalone && <meta name="robots" content="noindex" />}
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    {/* Preload only what paints the largest text first: the Arabic verse on item
        pages, the italic verse of the day on the home page. */}
    {arabic && <link rel="preload" href={amiri} as="font" type="font/woff2" crossorigin />}
    {home && <link rel="preload" href={displayItalicA} as="font" type="font/woff2" crossorigin />}
    {home && lang === 'tr' && <link rel="preload" href={displayItalicB} as="font" type="font/woff2" crossorigin />}
    {!standalone && (
      <>
        <link rel="canonical" href={abs(Astro.url.pathname)} />
        <link rel="alternate" hreflang={lang} href={abs(Astro.url.pathname)} />
        <link rel="alternate" hreflang={other} href={abs(localeUrl(other, altPath))} />
        <link
          rel="alternate"
          hreflang="x-default"
          href={abs(lang === 'tr' ? Astro.url.pathname : localeUrl('tr', altPath))}
        />
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t(lang, 'siteName')} />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:locale" content={lang === 'tr' ? 'tr_TR' : 'en_US'} />
    <meta property="og:image" content={abs(url(`og-${lang}.png`))} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content={palettes.day.paper} />
    <script is:inline set:html={paletteScript} />
    <style is:global set:html={paletteCss} />
  </head>
  <body>
    <FloraDefs />
    <a class="skip-link" href="#main">
      {t(lang, 'skip')}
    </a>
    <header class="site-header">
      <div class="wrap wrap--wide site-header__inner">
        <a class="site-name" href={standalone ? url('') : localeUrl(lang)}>
          <svg class="site-mark" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
            <circle cx="20" cy="20" r="18.5" />
            <path d="M20 4 L24.6 15.4 L36 20 L24.6 24.6 L20 36 L15.4 24.6 L4 20 L15.4 15.4Z" />
            <path d="M8.7 8.7 L20 13.4 L31.3 8.7 L26.6 20 L31.3 31.3 L20 26.6 L8.7 31.3 L13.4 20Z" />
            <circle class="site-mark__eye" cx="20" cy="20" r="2.6" />
          </svg>
          <span>{t(lang, 'siteName')}</span>
          <span class="site-subtitle">{t(lang, 'siteSubtitle')}</span>
        </a>
        {!standalone && (
          <nav class="site-nav" aria-label={t(lang, 'navLabel')}>
            {sections.map(([key, label]) => (
              <a href={sectionUrl(key, lang)} aria-current={section === key ? 'page' : undefined}>
                {t(lang, label)}
              </a>
            ))}
          </nav>
        )}
        <div class="site-tools">
          {!standalone && (
            <a
              class="garden-link"
              href={localeUrl(lang, lang === 'tr' ? 'bahce/' : 'garden/')}
              title={t(lang, 'garden')}
            >
              <svg viewBox="-12 -40 24 42" aria-hidden="true" focusable="false">
                <use href="#fl-leaf-l" transform="translate(-1 0) rotate(-38) scale(0.5)" />
                <use href="#fl-leaf-r" transform="translate(1 0) rotate(38) scale(0.5)" />
                <use href="#fl-tulip" transform="translate(0 -4) scale(0.8)" />
              </svg>
              <span class="visually-hidden">{t(lang, 'garden')}</span>
            </a>
          )}
          {!standalone && (
            <a
              class="lang-switch"
              href={localeUrl(other, altPath)}
              hreflang={other}
              lang={other}
              title={t(lang, 'langSwitchLabel')}
            >
              {t(lang, 'langSwitch')}
            </a>
          )}
          <PaletteControl lang={lang} />
        </div>
      </div>
    </header>
    <TileBorder height={28} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <div class="footer-gap"></div>
    <TileBorder height={28} />
    <footer class="site-footer">
      <div class="wrap wrap--wide">
        <p>
          {t(lang, 'footerTexts')} <a href="https://tanzil.net">Tanzil Project · tanzil.net</a>.
          {t(lang, 'footerTranslit')} <a href="https://quran.com">Quran.com</a>.
        </p>
        {!standalone && (
          <p>
            <a href={localeUrl(lang, lang === 'tr' ? 'sozluk/' : 'glossary/')}>{t(lang, 'glossary')}</a> ·{' '}
            <a href={localeUrl(lang, lang === 'tr' ? 'hakkinda/' : 'about/')}>{t(lang, 'about')}</a> ·{' '}
            <a href={localeUrl(lang, lang === 'tr' ? 'bahce/' : 'garden/')}>{t(lang, 'garden')}</a>
          </p>
        )}
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    background: var(--paper);
  }
  .garden-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    border-radius: var(--radius);
  }
  .garden-link svg {
    width: 1.3rem;
    height: auto;
    overflow: visible;
  }
  .site-mark {
    width: 1.6rem;
    height: 1.6rem;
    align-self: center;
    fill: none;
    stroke: var(--cobalt);
    stroke-width: 1.4;
  }
  .site-mark circle:first-child {
    stroke: var(--lamp-line);
  }
  .site-mark__eye {
    fill: var(--clay);
    stroke: none;
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 4rem;
    flex-wrap: wrap;
  }
  .site-name {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    flex-wrap: wrap;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 1.25rem;
  }
  .site-subtitle {
    font-family: var(--font-text);
    font-style: italic;
    font-size: 0.85rem;
    color: var(--ink-soft);
  }
  @media (max-width: 30rem) {
    .site-subtitle {
      display: none;
    }
  }
  .site-nav {
    display: flex;
    gap: var(--space-4);
    font-family: var(--font-ui);
    font-size: var(--step--1);
  }
  .site-nav a {
    text-decoration: none;
    color: var(--ink-soft);
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    border-bottom: 1px solid transparent;
  }
  .site-nav a:hover {
    color: var(--ink);
  }
  .site-nav a[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: var(--lamp);
  }
  @media (max-width: 40rem) {
    .site-nav {
      order: 3;
      width: 100%;
      justify-content: space-between;
      border-top: var(--rule);
      gap: var(--space-2);
    }
  }
  .site-tools {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .lang-switch {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    padding: var(--space-2);
    text-decoration: none;
    color: var(--ink-soft);
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
  }
  .lang-switch:hover {
    color: var(--ink);
  }
  .footer-gap {
    height: var(--space-7);
  }
  main:focus {
    outline: none;
  }
  .site-footer {
    padding-block: var(--space-5);
    font-family: var(--font-ui);
    font-size: 0.8rem;
    color: var(--ink-soft);
  }
</style>
